# PAJ Ramp Configuration
# Business API key from PAJ Ramp dashboard
VITE_BUSINESS_API_KEY=your_paj_business_api_key_here

# PAJ Webhook URL (optional, for order status updates)
VITE_PAJ_WEBHOOK_URL=https://your-domain.com/webhook/paj-ramp

